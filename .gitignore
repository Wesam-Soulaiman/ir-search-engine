# Reports

# Reports are allowed to be committed.

# This includes reports/evaluation/*.csv for evaluation charts.

# ============================================================

!reports/
!reports/**
!reports/evaluation/
!reports/evaluation/**

# Ignore only temporary report files

reports/**/*.tmp
reports/**/*.bak
reports/**/~$*
reports/**/*.aux
reports/**/*.log
reports/**/*.out

