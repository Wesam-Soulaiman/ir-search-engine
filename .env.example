# Django
DJANGO_SECRET_KEY=change-this-before-demo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DATABASE_PATH=backend/db.sqlite3

# Local frontend origins
DJANGO_CORS_ALLOW_ALL_ORIGINS=False
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Project storage
IR_DATA_DIR=data
IR_INDEXES_DIR=indexes
IR_REPORTS_DIR=reports
IR_ARTIFACTS_DIR=artifacts

# ir_datasets cache
# Leave empty to use the default location: ~/.ir_datasets
IR_DATASETS_HOME=
IR_DATASETS_TMP=

# Hugging Face cache
HF_HOME=

# Set to True only after models and indexes are stored locally.
IR_OFFLINE_MODE=False

# Logging
LOG_LEVEL=INFO


IR_CORPUS_DATABASE_PATH=artifacts/database/corpus.sqlite3